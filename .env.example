# Betsim environment configuration template.
# Copy to .env and fill in values as needed.

# TheOddsAPI key (live odds + scores collection)
BETSIM_THEODDSAPI_API_KEY=

# Comma-separated sport keys the scheduler collects (default below)
# BETSIM_SCHEDULER_SPORTS=americanfootball_nfl,americanfootball_ncaaf,basketball_nba,mma_mixed_martial_arts

# Database path override (defaults to ~/.betsim/betsim.db)
# BETSIM_DB_PATH=

# Backend port (defaults to 8000)
# BETSIM_PORT=8000
